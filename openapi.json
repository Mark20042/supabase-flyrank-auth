{
  "openapi": "3.0.0",
  "info": {
    "title": "FlyRank Auth API",
    "version": "1.0.0",
    "description": "Secure API with Supabase Auth: sign up, log in, log out, JWT token verification, and protected routes."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/public/info": {
      "get": {
        "summary": "Public Info",
        "description": "Returns open public data without authentication.",
        "responses": {
          "200": {
            "description": "Successful public response",
            "content": {
              "application/json": {
                "example": {
                  "message": "Welcome stranger! This info is public."
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "Register a new user",
        "description": "Creates a new user account with email and password in Supabase Auth.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "test@example.com" },
                  "password": { "type": "string", "example": "password123" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully"
          },
          "400": {
            "description": "Bad request (missing email/password or validation error)"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user",
        "description": "Authenticates credentials and returns a JWT access token and refresh token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "test@example.com" },
                  "password": { "type": "string", "example": "password123" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully authenticated with JWT access_token"
          },
          "400": {
            "description": "Missing credentials"
          },
          "401": {
            "description": "Invalid login credentials"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Log out user",
        "description": "Terminates the active user session in Supabase.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "No Content - successfully logged out"
          },
          "401": {
            "description": "Unauthorized - Missing, invalid, or expired token"
          }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "summary": "Get authenticated user profile",
        "description": "Returns verified user metadata (id, email, created_at). Requires Bearer JWT token.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved profile data"
          },
          "401": {
            "description": "Unauthorized - Missing, invalid, or expired token"
          }
        }
      }
    },
    "/protected/dashboard": {
      "get": {
        "summary": "Get user dashboard",
        "description": "A second protected endpoint demonstrating reusable middleware auth guarding.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved protected dashboard"
          },
          "401": {
            "description": "Unauthorized - Missing, invalid, or expired token"
          }
        }
      }
    }
  }
}

